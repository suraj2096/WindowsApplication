<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="EmailHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- ============================= -->
        <!-- LOGIN SCREEN -->
        <!-- ============================= -->

        <Grid x:Name="LoginView"
      Background="#F5F7FB">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
            Width="460"
            Padding="42"
            CornerRadius="20"
            Background="White">

                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <StackPanel>

                    <!-- Logo -->
                    <Border Width="64"
                    Height="64"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    Background="#E8F1FF"
                    Margin="0,0,0,24">

                        <TextBlock Text="✉"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#2563EB"/>
                    </Border>


                    <!-- Title -->
                    <TextBlock Text="Welcome to MailHub"
                       FontSize="30"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="#111827"/>


                    <!-- Subtitle -->
                    <TextBlock Text="Your Microsoft mailbox, in one place."
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Foreground="#667085"
                       Margin="0,10,0,32"/>


                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                    Height="52"
                    HorizontalAlignment="Stretch"
                    Click="LoginButton_Click"
                    Background="#2563EB"
                    Foreground="White"
                    CornerRadius="8">

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                            <TextBlock Text="Sign in with Microsoft"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>


                    <!-- Loading -->
                    <ProgressRing
                    x:Name="LoginProgress"
                    Width="22"
                    Height="22"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Margin="0,18,0,0"/> 

                    <Button
                        x:Name="CancelLoginButton"
                        Content="Cancel and try again"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,0"
                        Click="CancelLoginButton_Click"/>           

                    <!-- Security -->
                    <StackPanel Margin="0,28,0,0">

                        <TextBlock Text="🔒  Secure Microsoft authentication"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#667085"/>

                        <TextBlock Text="MailHub never stores your Microsoft password."
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="#98A2B3"
                           Margin="0,7,0,0"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ============================= -->
        <!-- MAIL APPLICATION -->
        <!-- ============================= -->

        <Grid
            x:Name="MailView"
            Visibility="Collapsed"
            Background="White">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ============================= -->
            <!-- TOP HEADER -->
            <!-- ============================= -->

            <Border
                Grid.Row="0"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                <Grid Margin="25,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>


                    <!-- Application name -->

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="✉"
                            FontSize="24"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"/>

                        <TextBlock
                            Text="MailHub"
                            FontSize="24"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                    </StackPanel>


                    <!-- Search -->

                    <TextBox
                        Grid.Column="1"
                        Width="420"
                        Height="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        PlaceholderText="Search mail"/>


                    <!-- User -->

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                        <Border
                            Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="#2563EB"
                            Margin="0,0,10,0">

                            <TextBlock
                                x:Name="UserInitialText"
                                Text="U"
                                Foreground="White"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel
                            Margin="0,0,15,0">

                            <TextBlock
                                x:Name="UserNameText"
                                FontSize="14"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                x:Name="UserEmailText"
                                FontSize="12"
                                Foreground="#6B7280"/>

                        </StackPanel>

                        <Button
                            Content="Sign out"
                            Padding="15,8"
                            Click="SignOutButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ============================= -->
            <!-- MAIN CONTENT -->
            <!-- ============================= -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ============================= -->
                <!-- SIDEBAR -->
                <!-- ============================= -->

                <Border
                    Grid.Column="0"
                    Background="#F8F9FC">

                    <StackPanel Margin="20">

                        <Button
                            Content="Inbox"
                            Height="42"
                            Margin="0,0,0,8"/>

                        <Button
                            Content="★  Starred"
                            Height="42"
                            Margin="0,0,0,8"/>

                        <Button
                            Content="↗  Sent"
                            Height="42"
                            Margin="0,0,0,8"/>

                        <Button
                            Content="Drafts"
                            Height="42"
                            Margin="0,0,0,8"/>

                        <Button
                            Content="Deleted"
                            Height="42"
                            Margin="0,0,0,8"/>

                        <!-- WinUI 3 doesn't need WPF Separator -->
                        <Border
                            Height="1"
                            Background="#E5E7EB"
                            Margin="0,15"/>

                        <Button
                            Content="Calendar"
                            Height="42"
                            Margin="0,0,0,8"/>

                        <Button
                            Content="Contacts"
                            Height="42"/>

                    </StackPanel>

                </Border>


                <!-- ============================= -->
                <!-- EMAIL LIST -->
                <!-- ============================= -->

                <Border
                    Grid.Column="1"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,1,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="0"
                            Text="Inbox"
                            FontSize="24"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="25,0"/>


                        <ListView
                            Grid.Row="1"
                            x:Name="EmailList"
                            BorderThickness="0"
                            SelectionChanged="EmailList_SelectionChanged">

                            <!-- We will populate this from your ViewModel -->

                        </ListView>

                    </Grid>

                </Border>


                <!-- ============================= -->
                <!-- EMAIL DETAILS -->
                <!-- ============================= -->

                <Grid
                    Grid.Column="2"
                    Padding="35">

                    <StackPanel>

                        <TextBlock
                            x:Name="EmailSubjectText"
                            Text="Select an email"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            x:Name="EmailSenderText"
                            Margin="0,15,0,25"
                            FontSize="14"
                            Foreground="#6B7280"/>

                        <Border
                            Height="1"
                            Background="#E5E7EB"/>

                        <TextBlock
                            x:Name="EmailBodyText"
                            Margin="0,25,0,0"
                            FontSize="15"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>